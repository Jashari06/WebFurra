{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.xn--balkan-beckerei-grill-d2b.de" }],
      "destination": "https://xn--balkan-beckerei-grill-d2b.de/:path*",
      "permanent": true
    }
  ]
}
